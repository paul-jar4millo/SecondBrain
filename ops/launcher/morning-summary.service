[Unit]
Description=SecondBrain morning summary thread written by Marina
After=secondbrain-launcher.service
Requires=secondbrain-launcher.service

[Service]
Type=oneshot
User=secondbrain
Group=secondbrain
ExecStart=/bin/bash /opt/secondbrain/current/ops/launcher/morning-summary.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
