# SecondBrain LXC parameters (example). Copy to ops/lxc/lxc.env, which is
# git-ignored, and fill in your own values. No secrets belong here.
# Addresses use the RFC 5737 documentation range and example.com.

# SSH alias of the Proxmox VE host (key-based, no password).
HOST_SSH=pve

VMID=210
NOMBRE=app-secondbrain
IP=192.0.2.10/24
GATEWAY=192.0.2.1
BRIDGE=vmbr0
ALMACEN=local
DISCO_GB=24
CPU=2
MEMORIA_MB=6144
SWAP_MB=512
# pveam template; downloaded when missing.
PLANTILLA=debian-13-standard_13.6-1_amd64.tar.zst
ZONA=America/Mexico_City

# Network and domain. The reverse proxy points to IP:8080.
DOMINIO=secondbrain.example.com
PROXY_IP=192.0.2.2
# Optional home-lab PC woken by Wake-on-LAN (ops/homelab).
PC_IP=192.0.2.20
PC_MAC=00:00:5e:00:53:01
PC_BROADCAST=192.0.2.255
REMOTE_WORKDIR=/srv/sb-agente/proyectos/SecondBrain
# Provision integrations without making provider calls until explicitly activated.
ACTIVAR_AUTOMATIZACIONES=0
# Empty: the public HTTPS health check is skipped (rehearsals).
HEALTH_PUBLICO=https://secondbrain.example.com/api/v1/health

# GitHub
REPO_APP=your-user/SecondBrain
# Empty: creates a minimal synthetic vault instead of cloning one (rehearsals).
REPO_VAULT=
# Empty: the deployment runner is not registered (rehearsals).
RUNNER_NOMBRE=
RUNNER_ETIQUETA=secondbrain-production
RUNNER_VERSION=2.338.2
RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40

# Pinned versions (verified 2026-11-08)
NODE_VERSION=24.22.2
NODE_SHA256=48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75
CLAUDE_VERSION=2.1.319
CLAUDE_INSTALL_SHA256=49e8406d5d752708458b0a5c39991784102bf9aeb6488782f2b0dffe07f944eb
CODEX_VERSION=0.167.0
AGY_VERSION=1.5.9
AGY_URL=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.9-4515810895593472/linux-x64/cli_linux_x64.tar.gz
AGY_SHA512=d01eb13ba7750eed18907f1ae8860864371e0ad9064415e8d033d22b4bd7b9b4e4c7f962058520b452d67db1c33163d9a889d55a7dffa159596ec6cd91a87b79


# Git identity the agents use inside the container.
AGENT_GIT_NAME="SecondBrain agents"
AGENT_GIT_EMAIL=agents@secondbrain.invalid
