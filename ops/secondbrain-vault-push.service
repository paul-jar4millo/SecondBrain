[Unit]
Description=Push committed SecondBrain knowledge to its private repository
Wants=network-online.target
After=network-online.target
OnFailure=secondbrain-notify@%n.service

[Service]
Type=oneshot
User=secondbrain
Group=secondbrain
WorkingDirectory=/srv/secondbrain/vault
Environment="GIT_SSH_COMMAND=/usr/bin/ssh -F /dev/null -i /var/lib/secondbrain/vault-git/id_ed25519 -o UserKnownHostsFile=/var/lib/secondbrain/vault-git/known_hosts -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -o BatchMode=yes"
ExecStart=/usr/bin/git push origin HEAD:main
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/secondbrain/vault/.git
