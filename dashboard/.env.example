# Optional. Without VAULT_ROOT, development serves synthetic demo data only.
# Compose paths are relative to dashboard/. The real vault lives only on the server:
# point this at a temporary test folder when packaging locally.
VAULT_ROOT=/ruta/a/vault-de-prueba
DATA_DIR=./.data
APP_UID=1000
APP_GID=1000
TRUSTED_PROXY=172.30.61.1
# Login: off for local dev (default). Set AUTH=on to require password; production (NODE_ENV=production) enables it unless AUTH=off.
# AUTH=on
# Proyecto Mundo Hipotético: carpeta del paquete. Por omisión, DATA_DIR/mundo.
# MUNDO_PAQUETE=/ruta/a/mundo-hipotetico/.local/paquete-panel

# Shared service: disable only the web UI, preserving API/MCP.
# SERVE_DASHBOARD=off
# VAULT_GIT=on requires an initialized independent vault repository.
# VAULT_GIT=on
