{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // JS files can only annotate catch variables as any or unknown, so this
    // would mean an any cast on every catch; errors are narrowed where used.
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "service/*.mjs",
    "mcp/*.mjs",
    "launcher/*.mjs",
    "ops/*.mjs",
    "ops/deploy/*.mjs",
    "ops/homelab/*.mjs",
    "launcher/lib/**/*.mjs",
    "launcher/execution/*.mjs",
    "launcher/conversation/*.mjs",
    "launcher/threads/*.mjs",
    "service/lib/*.mjs",
    "service/http/**/*.mjs",
    "ops/launcher/*.mjs"
  ]
}
